{
  "name": "SpyChat",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev]'",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "SpyChat Web",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "SPYCHAT_SECRET_KEY": "dev-codespace-key-change-in-prod",
    "SPYCHAT_DATA_DIR": "/tmp/spychat-data"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  },
  "postAttachCommand": {
    "hint": "echo '➡  Run:  spychat-web --host 0.0.0.0   then open the forwarded port 5000'"
  }
}
